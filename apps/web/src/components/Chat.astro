---
// Floating chat, configured in content/chat.yaml (editor: Profile & settings → Chat).
// Answers the configured FAQs on the page, then hands a typed message to the chosen channel:
//   email     - the visitor's email app, to the email in Let's Talk (default)
//   whatsapp  - WhatsApp to your number (the number is visible in the page)
//   telegram  - Telegram chat with your username (number stays private)
//   tawk      - Tawk.to live chat; you reply from the Tawk app on your phone (loads only when opened)
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';

const c = (await getEntry('chat', 'chat'))?.data;
const email = (await getEntry('connect', 'connect'))?.data.email;
const digits = c?.whatsapp_number?.replace(/\D/g, '') ?? '';
const tg = c?.telegram_username?.trim().replace(/^@/, '') ?? '';
const tawk = c?.tawk_property_id?.trim() && c?.tawk_widget_id?.trim() ? `${c.tawk_property_id.trim()}/${c.tawk_widget_id.trim()}` : '';
const fb = (await getEntry('feedback', 'feedback'))?.data;
const w3fKey = c?.web3forms_key?.trim() || (fb?.delivery === 'web3forms' ? fb.service_key?.trim() : '') || '';
const ready = { web3forms: !!w3fKey, email: !!email, whatsapp: digits.length >= 8, telegram: /^[A-Za-z0-9_]{5,32}$/.test(tg), tawk: !!tawk };
// A channel without its setting falls back to email, so the chat always works.
let channel = c?.channel ?? 'email';
if (c?.enabled && !ready[channel]) {
  console.warn(`[chat] ${channel} isn't set up; using email instead.`);
  channel = 'email';
}
const show = !!c?.enabled && ready[channel];
// Visible questions, with links made absolute for the site's base path (#connect works from any page).
const base = import.meta.env.BASE_URL;
const href = (l?: string) => {
  const v = l?.trim();
  if (!v) return undefined;
  if (v.startsWith('#')) return `${base}${v}`;
  if (v.startsWith('/')) return `${base}${v.slice(1)}`;
  return /^(https?:|mailto:)/.test(v) ? v : undefined;
};
const faqs = (c?.faqs ?? []).filter((q) => q.show).map((q) => ({
  question: q.question, answer: q.answer, link: href(q.link), label: q.link_label?.trim() || (href(q.link) ? 'Open' : undefined),
}));
// Tawk.to live chat can sit alongside a Web3Forms message box (when a Web3Forms key is available).
const live = channel === 'tawk';
const send = live ? (ready.web3forms ? 'web3forms' : null) : channel; // where typed messages go
const channelName = { web3forms: 'my inbox', email: 'your email app', whatsapp: 'WhatsApp', telegram: 'Telegram', tawk: 'live chat' }[send ?? 'tawk'];
const captcha = send === 'web3forms' && c!.captcha;
// Only the active channel's details go into the page: an unused WhatsApp number or key stays out of it.
const config = show ? {
  channel: send ?? 'tawk', live, email, title: c!.title, captcha,
  whatsapp: send === 'whatsapp' ? digits : '',
  telegram: send === 'telegram' ? tg : '',
  tawk: live ? tawk : '',
  w3fKey: send === 'web3forms' ? w3fKey : '',
  note: live && send ? 'Send a message to my inbox, or start a live chat.' : c!.handoff_note.replace('{channel}', channelName),
} : null;
---
{show && c && (
  <div class="chat" data-chat={JSON.stringify(config)}>
    <section class="chat-panel" id="chat-panel" role="dialog" aria-modal="false" aria-labelledby="chat-title" hidden>
      <div class="chat-head">
        <span class="chat-avatar" aria-hidden="true">JC</span>
        <div>
          <h2 id="chat-title">{c.title}</h2>
          {c.status && <p>{c.status}</p>}
        </div>
        <button type="button" class="chat-close" data-chat-close aria-label="Close chat"><Icon name="x" /></button>
      </div>
      <div class="chat-log" role="log" aria-live="polite">
        <p class="bubble bot">{c.greeting}</p>
      </div>
      {faqs.length > 0 && (
        <div class="chat-chips" aria-label="Suggested questions">
          {faqs.map((q, i) => <button type="button" class="chip" data-faq={i}>{q.question}</button>)}
        </div>
      )}
      {send && (
        <form class="chat-compose" novalidate>
          {send === 'web3forms' && (
            <div class="chat-email">
              <label class="sr-only" for="chat-email">Your email</label>
              <input id="chat-email" type="email" autocomplete="email" required={c.ask_email === 'required'}
                placeholder={c.ask_email === 'required' ? 'Your email, so I can reply' : 'Your email (optional, for a reply)'} />
            </div>
          )}
          {captcha && <div class="chat-captcha" hidden><div class="h-captcha" data-captcha="true"></div></div>}
          <label class="sr-only" for="chat-input">Message</label>
          <textarea id="chat-input" rows="1" placeholder={c.input_placeholder} required></textarea>
          <button type="submit" class="chat-send" aria-label="Send"><Icon name="send" /></button>
        </form>
      )}
      {live && (
        <div class="chat-compose chat-live-row">
          <button type="button" class="btn primary chat-live" data-chat-live>Start a live chat</button>
        </div>
      )}
      <p class="chat-note">{config!.note}</p>
      <script type="application/json" data-chat-faqs set:html={JSON.stringify(faqs).replace(/</g, '\\u003c')} />
    </section>
    <button type="button" class="chat-fab" aria-expanded="false" aria-controls="chat-panel" data-chat-toggle>
      <Icon name="message-circle" /><span>{c.button_label}</span>
    </button>
  </div>
)}

<script>
  import { loadCaptcha, captchaToken, resetCaptcha } from '../lib/captcha';
  type Cfg = { channel: 'web3forms' | 'email' | 'whatsapp' | 'telegram' | 'tawk'; live: boolean; w3fKey: string; captcha: boolean; email?: string; whatsapp: string; telegram: string; tawk: string; title: string; note: string };
  const root = document.querySelector<HTMLElement>('.chat[data-chat]');
  if (root) {
    const cfg: Cfg = JSON.parse(root.dataset.chat!);
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel);
    const panel = $<HTMLElement>('.chat-panel')!;
    const fab = $<HTMLButtonElement>('.chat-fab')!;
    const log = $<HTMLElement>('.chat-log')!;
    const faqs: { question: string; answer: string; link?: string; label?: string }[] = JSON.parse($('[data-chat-faqs]')?.textContent || '[]');
    const track = (name: string, label?: string, extra?: Record<string, string>) => (window as any).jcTrack?.(name, label, extra);
    let opened = false;

    const setOpen = (open: boolean, how = 'button') => {
      panel.hidden = !open;
      fab.setAttribute('aria-expanded', String(open));
      document.documentElement.classList.toggle('chat-open', open);
      if (open) {
        if (!opened) { opened = true; track('chat_open', location.pathname, { how }); } else track('chat_reopen', location.pathname);
        ($<HTMLElement>('#chat-input') ?? $<HTMLElement>('.chip') ?? panel).focus();
      } else {
        track('chat_close', location.pathname);
        fab.focus();
      }
    };
    fab.addEventListener('click', () => setOpen(panel.hidden));
    root.addEventListener('click', (e) => { if ((e.target as Element).closest('[data-chat-close]')) setOpen(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) setOpen(false); });

    const bubble = (text: string, who: 'bot' | 'me') => {
      const p = document.createElement('p');
      p.className = `bubble ${who}`; p.textContent = text;
      log.append(p); log.scrollTop = log.scrollHeight;
      return p;
    };
    const botSays = (text: string, link?: { href: string; label: string; question: string }) => {
      const typing = bubble('…', 'bot'); typing.classList.add('typing'); typing.setAttribute('aria-hidden', 'true');
      setTimeout(() => {
        typing.remove();
        const p = bubble(text, 'bot');
        if (link) {
          const a = document.createElement('a');
          a.className = 'bubble-link'; a.href = link.href; a.textContent = link.label;
          if (/^https?:/.test(link.href) && !link.href.startsWith(location.origin)) { a.target = '_blank'; a.rel = 'noopener'; }
          a.addEventListener('click', () => {
            track('chat_faq_link', link.question, { to: link.href });
            // Same-page section links: close the chat so the section is visible.
            if (a.pathname === location.pathname && a.hash) setOpen(false);
          });
          p.append(document.createElement('br'), a);
          log.scrollTop = log.scrollHeight;
        }
      }, 450);
    };

    // FAQ chips: answered on the page.
    root.addEventListener('click', (e) => {
      const chip = (e.target as Element).closest<HTMLButtonElement>('[data-faq]');
      if (!chip) return;
      const q = faqs[Number(chip.dataset.faq)];
      bubble(q.question, 'me');
      botSays(q.answer, q.link ? { href: q.link, label: q.label!, question: q.question } : undefined);
      track('chat_faq', q.question);
    });

    // Hand a typed message to the chosen channel.
    function handoff(text: string) {
      const page = `\n\n(Sent from ${location.href})`;
      if (cfg.channel === 'whatsapp') return `https://wa.me/${cfg.whatsapp}?text=${encodeURIComponent(text + page)}`;
      if (cfg.channel === 'telegram') return `https://t.me/${cfg.telegram}`;
      return `mailto:${cfg.email}?subject=${encodeURIComponent(`Chat from the site`)}&body=${encodeURIComponent(text + page)}`;
    }
    const form = $<HTMLFormElement>('form.chat-compose');
    const input = $<HTMLTextAreaElement>('#chat-input');
    if (form && input) {
      // Grow with the text, up to a few lines; Enter sends, Shift+Enter adds a line.
      input.addEventListener('input', () => { input.style.height = 'auto'; input.style.height = `${Math.min(input.scrollHeight, 120)}px`; });
      input.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); } });
      const emailBox = $<HTMLInputElement>('#chat-email');
      const captchaWrap = $<HTMLElement>('.chat-captcha');
      const captchaBox = captchaWrap?.querySelector('.h-captcha') ?? null;
      let captchaFailed = false;
      // The spam check appears (and loads) once the visitor starts typing.
      input.addEventListener('input', () => {
        if (captchaWrap && captchaWrap.hidden && input.value.trim()) {
          captchaWrap.hidden = false;
          loadCaptcha().then((ok) => { captchaFailed = !ok; log.scrollTop = log.scrollHeight; });
        }
      });
      const warn = (msg: string) => { botSays(msg); };
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const text = input.value.trim();
        if (!text) return;
        if (cfg.channel === 'web3forms') { await sendToInbox(text); return; }
        bubble(text, 'me');
        input.value = ''; input.style.height = '';
        const url = handoff(text);
        if (cfg.channel === 'telegram') {
          // Telegram links can't carry a message, so copy it for pasting.
          try { await navigator.clipboard.writeText(text); botSays('Copied your message. Paste it into the Telegram chat that just opened.'); }
          catch { botSays('Telegram is opening. Paste or retype your message there.'); }
        } else {
          botSays(cfg.channel === 'whatsapp' ? 'Opening WhatsApp with your message. Press send there and it reaches me directly.' : 'Opening your email app with your message. Press Send and it reaches me directly.');
        }
        track('chat_message', cfg.channel, { length: String(text.length) });
        if (cfg.channel === 'email') window.location.href = url; else window.open(url, '_blank', 'noopener');
      });

      // Web3Forms: the message goes straight to Jawahar's inbox; the visitor's email is the reply-to.
      let sending = false;
      async function sendToInbox(text: string) {
        if (sending) return;
        const email = emailBox?.value.trim() ?? '';
        if ((emailBox?.required && !email) || (email && !emailBox!.checkValidity())) {
          warn('Please add a valid email address above so I can reply.'); emailBox?.focus(); return;
        }
        if (cfg.captcha && !captchaToken(captchaBox)) {
          if (captchaFailed) fallback(text, "The spam check couldn't load (an ad blocker may be stopping it).");
          else warn('Please tick the "I am human" check, then press send again.');
          return;
        }
        sending = true;
        bubble(text, 'me');
        input.value = ''; input.style.height = '';
        try {
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
              access_key: cfg.w3fKey, subject: 'Chat message from the site', from_name: 'Site chat',
              email, message: text, page: location.href,
              ...(cfg.captcha && { 'h-captcha-response': captchaToken(captchaBox) }),
            }),
          });
          if (!res.ok) throw new Error(String(res.status));
          botSays(email ? `Sent! Jawahar will reply to ${email}.` : 'Sent! Thanks for the message.');
          track('chat_message', 'web3forms', { length: String(text.length), with_email: email ? 'yes' : 'no' });
        } catch {
          fallback(text, "Sorry, that didn't send.");
          track('chat_message_failed', 'web3forms');
        } finally {
          sending = false;
          if (cfg.captcha) resetCaptcha(captchaBox);
        }
      }
      function fallback(text: string, why: string) {
        if (!cfg.email) { warn(`${why} Please try again in a moment.`); return; }
        // handoff() builds the email-app link for any channel other than WhatsApp/Telegram.
        botSays(`${why} You can send it from your email app instead.`, { href: handoff(text), label: 'Open my email app', question: 'chat-fallback' });
      }
    }

    // Tawk.to: load only when asked for, hide its own bubble, open its window.
    const live = $<HTMLButtonElement>('[data-chat-live]');
    live?.addEventListener('click', () => {
      track('chat_live_start', 'tawk');
      const w = window as any;
      if (w.Tawk_API?.maximize) { w.Tawk_API.showWidget(); w.Tawk_API.maximize(); setOpen(false); return; }
      live.disabled = true; live.textContent = 'Connecting…';
      w.Tawk_API = w.Tawk_API || {}; w.Tawk_LoadStart = new Date();
      w.Tawk_API.onLoad = () => { w.Tawk_API.maximize(); setOpen(false); live.disabled = false; live.textContent = 'Start a live chat'; };
      w.Tawk_API.onChatMinimized = () => w.Tawk_API.hideWidget();
      w.Tawk_API.onChatMessageVisitor = () => track('chat_message', 'tawk');
      w.Tawk_API.onChatStarted = () => track('chat_live_connected', 'tawk');
      const s = document.createElement('script');
      s.async = true; s.src = `https://embed.tawk.to/${cfg.tawk}`; s.charset = 'UTF-8'; s.setAttribute('crossorigin', '*');
      s.onerror = () => { live.disabled = false; live.textContent = 'Start a live chat'; botSays("Live chat couldn't load. Please try the Let's Talk section instead."); };
      document.head.append(s);
    });
  }
</script>
