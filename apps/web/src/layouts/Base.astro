---
import { getCollection, getEntry } from 'astro:content';
import { getSections, isVisible, withBase } from '../lib/content';
import Icon from '../components/Icon.astro';
import Analytics from '../components/Analytics.astro';
import Feedback from '../components/Feedback.astro';
import Chat from '../components/Chat.astro';
import { buildTheme } from '../lib/theme';
// Self-hosted fonts: no render-blocking request to a third-party host.
// One variable file per family covers every weight used (two downloads instead of five).
import '@fontsource-variable/ibm-plex-sans/wght.css';
import '@fontsource-variable/sora/wght.css';
import '../styles/global.css';
// Preload both font files so they download alongside the HTML instead of after it.
import soraFont from '@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url';
import plexFont from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';

interface Props { title?: string; description?: string; type?: 'website' | 'article' }
const about = (await getEntry('about', 'about'))!.data;
const { nav } = await getSections();
const feedback = (await getEntry('feedback', 'feedback'))?.data;
const hasBlog = (await getCollection('blog', (e) => isVisible(e.data.status))).length > 0;
const title = Astro.props.title ? `${Astro.props.title} · ${about.name}` : (about.seo_title ?? `${about.name} | ${about.role}`);
const description = Astro.props.description ?? about.description;
const home = import.meta.env.BASE_URL;
const theme = buildTheme((await getEntry('theme', 'theme'))?.data);
// WCAG 2.1 AA guardrail: report colors that were adjusted, and refuse to build if anything still fails.
for (const a of theme.adjusted) console.warn(`[theme] ${a.mode} ${a.color} ${a.requested} → ${a.used} to meet WCAG AA contrast`);
const failing = theme.checks.filter((c) => !c.pass);
if (failing.length) throw new Error(`Theme fails WCAG AA: ${failing.map((c) => `${c.mode} ${c.pair} ${c.ratio}:1 (needs ${c.min}:1)`).join('; ')}`);
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = about.social_image ? new URL(withBase(about.social_image), Astro.site).href : undefined;
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:type" content={Astro.props.type ?? 'website'}>
  <meta property="og:locale" content="en_US">
  <meta property="og:site_name" content={about.name}>
  {image && <meta property="og:image" content={image}>}
  {image && <meta property="og:image:width" content="1200">}
  {image && <meta property="og:image:height" content="630">}
  {image && about.social_image_alt && <meta property="og:image:alt" content={about.social_image_alt}>}
  <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'}>
  {image && <meta name="twitter:image" content={image}>}
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <link rel="preload" href={soraFont} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={plexFont} as="font" type="font/woff2" crossorigin>
  <link rel="canonical" href={canonical}>
  <meta name="theme-color" content={theme.light['--accent']} media="(prefers-color-scheme: light)">
  <meta name="theme-color" content={theme.dark['--accent']} media="(prefers-color-scheme: dark)">
  <style is:inline set:html={theme.css}></style>
  <Analytics />
  <link rel="sitemap" href={`${home}sitemap.xml`}>
  <slot name="head" />
  <!-- Site icons (generated from the theme colors at build time). Google needs a real file of 48px or more. -->
  <link rel="icon" href={`${home}favicon.ico`} sizes="48x48">
  <link rel="icon" href={`${home}favicon.svg`} type="image/svg+xml">
  <link rel="icon" href={`${home}favicon-96x96.png`} type="image/png" sizes="96x96">
  <link rel="apple-touch-icon" href={`${home}apple-touch-icon.png`}>
  <link rel="manifest" href={`${home}site.webmanifest`}>
</head>
<body>
  <div class="backdrop" aria-hidden="true">
    <span class="glow glow-a"></span><span class="glow glow-b"></span><span class="glow glow-c"></span>
  </div>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap nav">
      <a class="brand" href={home} aria-label="Home">JC</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <Icon name="menu" />Menu
      </button>
      <nav id="site-nav" aria-label="Primary">
        {nav.filter((s) => s.id !== 'about').map((s) => <a href={`${home}#${s.id}`}>{s.label}</a>)}
        {hasBlog && <a href={`${home}blog/`}>Blog</a>}
      </nav>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="site-footer wrap">
    <p>© {new Date().getFullYear()} {about.name}</p>
    <p class="footer-links">{feedback?.enabled && <button type="button" class="link-button" data-feedback-open>{feedback.button_label}</button>}<a href={`${home}privacy/`}>Privacy</a><button type="button" class="link-button" data-consent-settings hidden>Cookie settings</button></p>
  </footer>
  <Feedback />
  <Chat />
  <script>
    // Keep the Feedback tab and Chat button above the cookie banner while it's showing.
    const lift = () => {
      const banner = document.querySelector<HTMLElement>('.consent');
      const h = banner && !banner.hidden ? banner.getBoundingClientRect().height + 16 : 0;
      document.documentElement.style.setProperty('--dock-lift', `${Math.round(h)}px`);
    };
    new MutationObserver(lift).observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['hidden'] });
    addEventListener('resize', lift);
  </script>
  <script>
    // Collapsible sections and roles: remember each visitor's open/closed choices,
    // open a section when it's linked to, and expand or collapse everything at once.
    const KEY = 'jc-folds';
    const folds = [...document.querySelectorAll<HTMLDetailsElement>('details[data-fold]')];
    let saved: Record<string, boolean> = {};
    try { saved = JSON.parse(localStorage.getItem(KEY) ?? '{}'); } catch {}
    const save = () => {
      try { localStorage.setItem(KEY, JSON.stringify(Object.fromEntries(folds.map((d) => [d.dataset.fold, d.open])))); } catch {}
    };
    for (const d of folds) {
      if (d.dataset.fold! in saved) d.open = saved[d.dataset.fold!];
      d.addEventListener('toggle', save);
    }
    const reveal = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      const target = id ? document.getElementById(id) : null;
      target?.querySelector<HTMLDetailsElement>(':scope > details')?.setAttribute('open', '');
    };
    reveal();
    addEventListener('hashchange', reveal);
    // Phone menu: toggles the nav panel; closes after a link is chosen.
    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const header = document.querySelector('.site-header');
    const setMenu = (open: boolean) => {
      header?.classList.toggle('menu-open', open);
      toggle?.setAttribute('aria-expanded', String(open));
    };
    toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
    document.querySelectorAll('#site-nav a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
    addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
    // Skill grid: search plus minimum-level filter. Groups with no matches hide; matches are highlighted.
    const search = document.querySelector<HTMLInputElement>('#skill-search');
    const levelBtns = [...document.querySelectorAll<HTMLButtonElement>('.level-filter button')];
    const hits = document.querySelector<HTMLElement>('.skill-hits');
    const emptyMsg = document.querySelector<HTMLElement>('.skill-empty');
    let minLevel = 0;
    const escapeRe = (t: string) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    document.querySelectorAll<HTMLElement>('.skill-rows .hl').forEach((el) => (el.dataset.raw = el.textContent ?? ''));
    const applySkillFilter = () => {
      const q = (search?.value ?? '').trim().toLowerCase();
      let shown = 0, total = 0;
      document.querySelectorAll<HTMLDetailsElement>('.skill-group').forEach((group) => {
        let inGroup = 0;
        group.querySelectorAll<HTMLElement>('.skill-rows li').forEach((li) => {
          total++;
          const match = Number(li.dataset.score) >= minLevel && (!q || (li.dataset.text ?? '').includes(q));
          li.hidden = !match;
          if (match) inGroup++;
          li.querySelectorAll<HTMLElement>('.hl').forEach((el) => {
            const raw = el.dataset.raw ?? '';
            if (!q) { el.textContent = raw; return; }
            el.innerHTML = raw.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]!))
              .replace(new RegExp(escapeRe(q.replace(/[&<>]/g, '')), 'gi'), (m) => `<mark>${m}</mark>`);
          });
        });
        shown += inGroup;
        group.hidden = inGroup === 0;
        if (q && inGroup) group.open = true;
        const count = group.querySelector<HTMLElement>('summary .count');
        if (count) count.textContent = inGroup === Number(count.dataset.total) ? count.dataset.total! : `${inGroup}/${count.dataset.total}`;
      });
      if (hits) hits.textContent = `${shown} of ${total}`;
      if (emptyMsg) emptyMsg.hidden = shown > 0;
    };
    search?.addEventListener('input', applySkillFilter);
    levelBtns.forEach((btn) => btn.addEventListener('click', () => {
      minLevel = Number(btn.dataset.min);
      levelBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      applySkillFilter();
    }));

    // Evidence map: selecting a filled cell shows the highlight behind it.
    const evDetail = document.querySelector<HTMLElement>('.ev-detail');
    document.querySelector('.ev')?.addEventListener('click', (e) => {
      const cell = (e.target as HTMLElement).closest<HTMLButtonElement>('button.ev-cell');
      if (!cell || !evDetail) return;
      document.querySelectorAll('.ev button[aria-pressed="true"]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
      cell.setAttribute('aria-pressed', 'true');
      evDetail.replaceChildren();
      const strong = document.createElement('strong');
      strong.textContent = cell.dataset.skill ?? '';
      evDetail.append(strong, ` at ${cell.dataset.role}`, document.createElement('br'), cell.dataset.evidence || 'Listed on this role.');
    });
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-fold-all]')) {
      b.addEventListener('click', () => {
        const open = b.dataset.foldAll === 'open';
        for (const d of folds) d.open = open;
        save();
      });
    }
  </script>
</body>
</html>
