---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Status from '../components/Status.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';
import LogoTile from '../components/LogoTile.astro';
import LevelMeter from '../components/LevelMeter.astro';
import { brandFor } from '../lib/icons';
import { getResume } from '../lib/resume';
import {
  byOrder, formatMonth, yearRange, tenure, getSections, isPlaceholder, isVisible, showUnpublished, withBase, LEVELS,
} from '../lib/content';

const { nav, byId } = await getSections();
const aboutEntry = (await getEntry('about', 'about'))!;
const about = aboutEntry.data;
const { Content: Bio } = await render(aboutEntry);

const career = (await getCollection('career', (e) => isVisible(e.data.status)))
  .sort((a, b) => b.data.start.localeCompare(a.data.start));
const roles = career.filter((e) => !e.data.earlier);
const earlier = career.filter((e) => e.data.earlier);
const firstYear = career.at(-1)?.data.start.slice(0, 4);

const caseStudies = (await getCollection('case-studies', (e) => isVisible(e.data.status))).sort(byOrder);
const playbook = (await getCollection('playbook', (e) => isVisible(e.data.status))).sort(byOrder);
const toolkit = (await getCollection('toolkit')).sort(byOrder)
  .map((g) => ({ ...g, items: g.data.items.filter((i) => !isPlaceholder(i.name) || showUnpublished) }))
  .filter((g) => g.items.length);
const skillProfile = (await getCollection('skill-profile')).sort(byOrder).map((e) => e.data);
const tShape = (await getEntry('toolkit-meta', 't-shape'))?.data;
const allSkills = toolkit.flatMap((g) => g.items);
const score = (i: { level?: keyof typeof LEVELS }) => (i.level ? LEVELS[i.level].score : 0);
const skillFilters = [
  { min: 0, label: 'All' },
  { min: 3, label: 'Advanced+' },
  { min: 4, label: 'Expert' },
];
const levelLegend = (['expert', 'advanced-expert', 'advanced', 'working-advanced', 'working'] as const).map((l) => LEVELS[l]);
const levelClass = (sc: number) => `lv-${String(sc).replace('.', '')}`;

// T-shape: breadth = every group (shaded by its share of Expert skills); depth = Expert-level domains.
const breadth = toolkit.map((g) => {
  const expert = g.items.filter((i) => score(i) >= 3.5).length;
  const share = expert / g.items.length;
  return { label: g.data.label, count: g.items.length, expert, shade: share >= 0.5 ? 4 : share >= 0.3 ? 3 : share >= 0.12 ? 2 : 1 };
});
const depth = skillProfile.filter((d) => LEVELS[d.level].score >= 3.5);

// Evidence map: columns are roles that list skills (newest first); rows follow the matrix's group and item order.
const matrixIndex = new Map<string, { group: string; pos: number; level?: keyof typeof LEVELS }>();
toolkit.forEach((g, gi) => g.items.forEach((i, ii) => matrixIndex.set(i.name.toLowerCase(), { group: g.data.label, pos: gi * 1000 + ii, level: i.level })));
const evRoles = career.filter((e) => e.data.skills.length > 0).map((e) => ({
  label: e.data.short ?? e.data.org,
  years: e.data.end?.slice(0, 4) === e.data.start.slice(0, 4) ? e.data.start.slice(0, 4) : `${e.data.start.slice(0, 4)}–${e.data.end ? e.data.end.slice(2, 4) : ''}`,
  cells: new Map(e.data.skills.map((sk) => [sk.name.toLowerCase(), sk.evidence ?? ''])),
}));
const evSkills = [...new Map(career.flatMap((e) => e.data.skills.map((sk) => [sk.name.toLowerCase(), sk.name]))).values()]
  .map((name) => ({ name, ...(matrixIndex.get(name.toLowerCase()) ?? { group: 'Other', pos: 1e9 }) }))
  .sort((a, b) => a.pos - b.pos);
const evGroups = [...new Set(evSkills.map((r) => r.group))].map((group) => ({ group, rows: evSkills.filter((r) => r.group === group) }));
const education = (await getCollection('education')).sort(byOrder).map((e) => e.data);
const certifications = (await getCollection('certifications')).sort(byOrder).map((e) => e.data);
const credentialSections = [
  { id: 'education', items: education },
  { id: 'certifications', items: certifications },
].filter((c) => c.items.length > 0);
const connect = (await getEntry('connect', 'connect'))!.data;
const resume = await getResume();
const resumeTitle = resume && `PDF, ${resume.sizeKb} KB${resume.updated ? `, updated ${resume.updated.toLocaleString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })}` : ''}`;
const booking = connect.booking.url && !isPlaceholder(connect.booking.url) ? connect.booking.url : undefined;

const show = (id: string) => nav.some((s) => s.id === id);

// Structured data (schema.org Person) so search engines can connect the name, role and profiles.
const current = roles.find((r) => !r.data.end)?.data;
const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site).href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteUrl}#person`,
  name: about.name,
  url: siteUrl,
  jobTitle: about.role,
  description: about.description,
  ...(about.location && { homeLocation: { '@type': 'Place', name: about.location } }),
  ...(current && { worksFor: { '@type': 'Organization', name: current.org } }),
  alumniOf: education.map((i) => ({ '@type': 'CollegeOrUniversity', name: i.detail ?? i.name })),
  hasCredential: certifications.map((i) => ({
    '@type': 'EducationalOccupationalCredential', name: i.name, ...(i.detail && { recognizedBy: { '@type': 'Organization', name: i.detail } }),
  })),
  knowsAbout: [...new Set(allSkills.filter((i) => !i.level || LEVELS[i.level].score >= 3).map((i) => i.name))].filter((n) => !isPlaceholder(n)),
  sameAs: connect.links.map((l) => l.url),
};
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: about.name, url: siteUrl, publisher: { '@id': `${siteUrl}#person` } };
const section = (id: string) => ({
  id, title: byId[id]?.label ?? id, icon: byId[id]?.icon ?? 'circle', open: !byId[id]?.collapsed,
});
---
<Base>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script type="application/ld+json" set:html={JSON.stringify(website)} />
  </Fragment>
  <section class="hero wrap" id="top">
    <p class="eyebrow">{about.role}{about.location && <> · <span class="nowrap">{about.location}</span></>}</p>
    <h1>{about.name}</h1>
    <p class="lede">{about.tagline}</p>
    <div class="cta">
      {show('connect') && (
        <a class="btn primary" href={booking ?? '#connect'} data-track={booking ? 'contact_click' : 'nav_click'} data-track-label={booking ? 'booking' : 'lets-talk'}>
          <Icon name="calendar" />{booking ? connect.booking.label : section('connect').title}
        </a>
      )}
      {connect.links.map((l) => <a class="btn" href={l.url} rel="noopener" target="_blank">{l.label}<Icon name="external-link" /></a>)}
      {resume && <a class="btn" href={withBase(resume.href)} title={resumeTitle} target="_blank" rel="noopener" data-track="resume_download" data-track-label="hero"><Icon name="file-text" />{resume.label}</a>}
    </div>
    {about.stats.length > 0 && (
      <dl class="stats">
        {about.stats.map((s) => <div><dt>{s.value}</dt><dd>{s.label}</dd></div>)}
      </dl>
    )}
  </section>

  <div class="fold-controls wrap" aria-label="Sections">
    <button type="button" data-fold-all="open"><Icon name="unfold-vertical" />Expand all</button>
    <button type="button" data-fold-all="close"><Icon name="fold-vertical" />Collapse all</button>
  </div>

  {show('about') && (
    <Section {...section('about')}>
      <div class="prose"><Bio /></div>
    </Section>
  )}

  {show('career') && (
    <Section {...section('career')} count={`${roles.length + earlier.length} roles · since ${firstYear}`}>
      <ol class="journey">
        {roles.map(({ id, data: r }, i) => (
          <li class={!r.end ? 'is-current' : ''}>
            <details class="role" data-fold={`career-${id}`} open={i === 0}>
              <summary>
                <LogoTile name={r.org} logo={r.logo} mark={r.mark} />
                <span class="role-head">
                  <h3 class="role-title">{r.title} <Status status={r.status} /></h3>
                  <span class="role-org">{r.org}{r.product && <span class="role-product"> · {r.product}</span>}</span>
                  <span class="meta">
                    {formatMonth(r.start)} – {formatMonth(r.end)}
                    <span class="tenure">{tenure(r.start, r.end)}</span>
                    {!r.end && <span class="now">Current</span>}
                  </span>
                </span>
                <span class="chev"><Icon name="chevron-down" /></span>
              </summary>
              <div class="role-body">
                {(r.location || r.via) && (
                  <p class="role-facts">
                    {r.location && <span><Icon name="map-pin" />{r.location}</span>}
                    {r.via && <span><Icon name="building-2" />via {r.via}</span>}
                  </p>
                )}
                {r.clients.length > 0 && <p class="clients">Clients: {r.clients.join(', ')}</p>}
                {r.highlights.length > 0 && <ul>{r.highlights.filter((h) => !isPlaceholder(h)).map((h) => <li>{h}</li>)}</ul>}
              </div>
            </details>
          </li>
        ))}
        {earlier.length > 0 && (
          <li>
            <details class="role" data-fold="career-earlier">
              <summary>
                <span class="tile tile-md"><Icon name="briefcase" /></span>
                <span class="role-head">
                  <h3 class="role-title">Earlier career</h3>
                  <span class="meta">{earlier.at(-1)!.data.start.slice(0, 4)} – {earlier[0].data.end?.slice(0, 4)} · {earlier.length} roles</span>
                </span>
                <span class="chev"><Icon name="chevron-down" /></span>
              </summary>
              <ul class="earlier">
                {earlier.map(({ data: r }) => (
                  <li>
                    <LogoTile name={r.org} logo={r.logo} mark={r.mark} size="sm" />
                    <span><strong>{r.title}</strong>, {r.org}<span class="meta"> · {yearRange(r.start, r.end)}</span></span>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        )}
      </ol>
    </Section>
  )}

  {credentialSections.filter((c) => show(c.id)).map(({ id, items }) => (
    <Section {...section(id)} count={`${items.length}`}>
      <ul class="credentials">
        {items.map((i) => (
          <li class="credential">
            <LogoTile name={i.detail ?? i.name} logo={i.logo} mark={i.mark} icon={section(id).icon} />
            <span class="credential-text">
              <h3 class="credential-name">{i.name}</h3>
              {(i.detail || i.year) && <span class="meta">{[i.detail, i.year].filter(Boolean).join(' · ')}</span>}
            </span>
          </li>
        ))}
      </ul>
    </Section>
  ))}

  {show('case-studies') && (
    <Section {...section('case-studies')} count={caseStudies.length ? `${caseStudies.length}` : undefined}>
      {(
        <div class="cards">
          {caseStudies.map(({ id, data: c }) => (
            <a class="card link-card" href={`${import.meta.env.BASE_URL}case-studies/${id}/`}>
              <p class="tag">{c.domain} <Status status={c.status} /></p>
              <h3>{c.title}</h3>
              {!isPlaceholder(c.client) && <p class="card-client"><LogoTile name={c.client!} size="sm" />{c.client}</p>}
              {!isPlaceholder(c.summary) && <p>{c.summary}</p>}
              {!isPlaceholder(c.outcome) && <p class="result">{c.outcome}</p>}
            </a>
          ))}
        </div>
      )}
    </Section>
  )}

  {show('playbook') && (
    <Section {...section('playbook')} count={playbook.length ? `${playbook.length}` : undefined}>
      <p class="section-intro">Templates and artifacts from how I run product and programs.</p>
      {(
        <ul class="artifacts">
          {playbook.map(({ id, data: p }) => (
            <li>
              <a href={`${import.meta.env.BASE_URL}playbook/${id}/`}>
                <span class="kind"><Icon name="file-text" />{p.kind}</span>
                <span class="artifact-title">{p.title} <Status status={p.status} /></span>
                {!isPlaceholder(p.summary) && <span class="artifact-summary">{p.summary}</span>}
              </a>
            </li>
          ))}
        </ul>
      )}
    </Section>
  )}

  {show('toolkit') && (
    <Section {...section('toolkit')} count={`${allSkills.length} skills`}>
      <div class="tk-block">
        <h3 class="subhead"><Icon name="layers" />T-shaped profile</h3>
        <div class="t-axis"><span>Breadth: {breadth.length} skill groups</span><span>Darker = more Expert skills</span></div>
        <ul class="t-top">
          {breadth.map((b) => (
            <li class={`shade-${b.shade}`}>{b.label}<small>{b.count} skills · {b.expert} Expert</small></li>
          ))}
        </ul>
        {depth.length > 0 && (
          <div class="t-stem">
            <h4>{tShape?.title ?? 'Depth'}</h4>
            {tShape?.summary && <p>{tShape.summary}</p>}
            <ul>{depth.map((d) => <li><span>{d.name}</span><LevelMeter level={d.level} showLabel={false} /></li>)}</ul>
          </div>
        )}
      </div>

      {evRoles.length > 0 && (
        <div class="tk-block">
          <h3 class="subhead"><Icon name="route" />Skills by role</h3>
          <p class="section-intro">Each filled cell is backed by a highlight from that role. Select one to read it.</p>
          <div class="ev-scroll">
            <table class="ev">
              <thead>
                <tr>
                  <th scope="col">Skill</th>
                  {evRoles.map((r) => <th scope="col">{r.label}<span>{r.years}</span></th>)}
                </tr>
              </thead>
              <tbody>
                {evGroups.map(({ group, rows }) => (
                  <>
                    <tr class="ev-group"><td colspan={evRoles.length + 1}><span>{group}</span></td></tr>
                    {rows.map((row) => (
                      <tr>
                        <th scope="row"><span>{row.name}</span>{row.level && <LevelMeter level={row.level} showLabel={false} />}</th>
                        {evRoles.map((r) => {
                          const ev = r.cells.get(row.name.toLowerCase());
                          return (
                            <td>
                              {ev !== undefined
                                ? <button type="button" class="ev-cell on" aria-pressed="false" aria-label={`${row.name} at ${r.label}`} data-skill={row.name} data-role={`${r.label} (${r.years})`} data-evidence={ev} />
                                : <span class="ev-cell" />}
                            </td>
                          );
                        })}
                      </tr>
                    ))}
                  </>
                ))}
              </tbody>
            </table>
          </div>
          <p class="ev-detail" aria-live="polite">Select a filled cell to see the highlight behind it.</p>
        </div>
      )}

      <div class="tk-block">
        <h3 class="subhead"><Icon name="filter" />Every skill</h3>
        <div class="skill-tools">
          <input id="skill-search" type="search" placeholder={`Search ${allSkills.length} skills, e.g. Kafka, MuleSoft, Zendesk`} aria-label="Search skills" />
          <div class="level-filter" role="group" aria-label="Minimum level">
            {skillFilters.map((f, i) => <button type="button" data-min={f.min} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>)}
          </div>
          <span class="skill-hits" aria-live="polite">{allSkills.length} of {allSkills.length}</span>
        </div>
        <div class="level-legend">
          {levelLegend.map((l) => <span><i class={`swatch ${levelClass(l.score)}`} />{l.label}</span>)}
        </div>
        <div class="skill-groups">
          {toolkit.map((g, gi) => {
            const mix = [4, 3.5, 3, 2.5, 2, 1].map((sc) => ({ sc, n: g.items.filter((i) => score(i) === sc).length })).filter((m) => m.n);
            return (
              <details class="skill-group" data-fold={`toolkit-${g.id}`} open={gi === 0}>
                <summary>
                  <span class="group-name">{g.data.label}</span>
                  <span class="mix" role="img" aria-label={mix.map((m) => `${m.n} ${Object.values(LEVELS).find((l) => l.score === m.sc)?.label}`).join(', ')}>
                    {mix.map((m) => <span class={levelClass(m.sc)} style={`width:${(m.n / g.items.length) * 100}%`} />)}
                  </span>
                  <span class="count" data-total={g.items.length}>{g.items.length}</span>
                </summary>
                <ul class="skill-rows">
                  {g.items.map((i) => {
                    const svg = brandFor(i.name, i.logo);
                    return (
                      <li data-score={score(i)} data-text={`${i.name} ${i.evidence ?? ''}`.toLowerCase()} class={isPlaceholder(i.name) ? 'chip-placeholder' : ''}>
                        <span class="skill-name">
                          <span>{svg && <Fragment set:html={svg} />}<span class="hl">{i.name}</span></span>
                          {i.evidence && <span class="evidence hl">{i.evidence}</span>}
                        </span>
                        {i.level && <LevelMeter level={i.level} />}
                      </li>
                    );
                  })}
                </ul>
              </details>
            );
          })}
        </div>
        <p class="skill-empty" hidden>No skills match. Try a shorter word.</p>
      </div>
    </Section>
  )}

  {show('connect') && (
    <Section {...section('connect')} title={connect.heading}>
      {connect.intro && <p class="prose">{connect.intro}</p>}
      {booking && connect.booking.embed && (
        <iframe class="scheduler" src={booking} title={connect.booking.label} loading="lazy"></iframe>
      )}
      <div class="cta">
        {booking
          ? <a class="btn primary" href={booking} rel="noopener" target="_blank" data-track="contact_click" data-track-label="booking"><Icon name="calendar" />{connect.booking.label}</a>
          : showUnpublished && <span class="btn disabled"><Icon name="calendar" />{connect.booking.label} <Status status="planned" /></span>}
        {connect.email && <a class="btn" href={`mailto:${connect.email}`}><Icon name="mail" />{connect.email}</a>}
        {resume && <a class="btn" href={withBase(resume.href)} title={resumeTitle} target="_blank" rel="noopener" data-track="resume_download" data-track-label="lets-talk"><Icon name="file-text" />{resume.label}</a>}
      </div>
    </Section>
  )}
</Base>
