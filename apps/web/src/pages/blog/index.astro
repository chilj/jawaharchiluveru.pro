---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Status from '../../components/Status.astro';
import { isVisible } from '../../lib/content';
import { formatDate } from '../../lib/blog';

const posts = (await getCollection('blog', (e) => isVisible(e.data.status)))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const home = import.meta.env.BASE_URL;
---
<Base title="Blog" description="Notes on product management, platforms and AI-assisted delivery.">
  <div class="wrap detail">
    <a class="back" href={home}>← Home</a>
    <h1>Blog</h1>
    <p class="lede">Notes on product management, platforms and AI-assisted delivery.</p>
    <ul class="post-list">
      {posts.map((p) => (
        <li>
          <time datetime={p.data.date.toISOString().slice(0, 10)}>{formatDate(p.data.date)}</time>
          <h2><a href={`${home}blog/${p.id}/`}>{p.data.title}</a> <Status status={p.data.status} /></h2>
          <p>{p.data.summary}</p>
        </li>
      ))}
    </ul>
  </div>
</Base>
