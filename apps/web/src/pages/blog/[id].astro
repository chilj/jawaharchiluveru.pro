---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Status from '../../components/Status.astro';
import { isVisible } from '../../lib/content';
import { formatDate, readingMinutes } from '../../lib/blog';

export async function getStaticPaths() {
  const entries = await getCollection('blog', (e) => isVisible(e.data.status));
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const p = entry.data;
const { Content } = await render(entry);
const about = (await getEntry('about', 'about'))!.data;
const home = import.meta.env.BASE_URL;
const iso = (d: Date) => d.toISOString().slice(0, 10);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: p.title,
  description: p.summary,
  datePublished: iso(p.date),
  ...(p.updated && { dateModified: iso(p.updated) }),
  author: { '@type': 'Person', name: about.name, url: new URL(home, Astro.site).href },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  inLanguage: 'en-US',
  keywords: p.tags.join(', '),
};
---
<Base title={p.title} description={p.summary} type="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={iso(p.date)}>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <article class="wrap detail post">
    <a class="back" href={`${home}blog/`}>← All posts</a>
    <h1>{p.title} <Status status={p.status} /></h1>
    <p class="post-meta">
      <time datetime={iso(p.date)}>{formatDate(p.date)}</time> · {readingMinutes(entry.body ?? '')} min read{p.tags.length > 0 && <> · {p.tags.join(' · ')}</>}
    </p>
    <div class="prose"><Content /></div>
  </article>
</Base>
