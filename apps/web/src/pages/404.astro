---
import Base from '../layouts/Base.astro';
const home = import.meta.env.BASE_URL;
---
<Base title="Page not found">
  <script is:inline>
    // Old links from the github.io project path (/jawaharchiluveru.pro/...) → same page at the site root.
    (function () {
      var legacy = '/jawaharchiluveru.pro';
      var p = location.pathname;
      if (p === legacy || p.indexOf(legacy + '/') === 0) {
        location.replace((p.slice(legacy.length) || '/') + location.search + location.hash);
      }
    })();
  </script>
  <section class="wrap detail">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p class="lede">That page doesn't exist, or it has moved.</p>
    <p><a class="btn primary" href={home}>Go to the home page</a></p>
  </section>
</Base>
